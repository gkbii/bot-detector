# bot-detector -- environment for the OPTIONAL server.
#
# GENERATED BY `npm run registry` FROM server/registry/env.ts. Do not edit by hand.
#
# The Chrome extension needs NONE of this: it installs load-unpacked and scores in
# the browser with no account, no key and no server. Copy this to `.env` only if
# you are running the optional backend.
#
# Every value below is the default. Uncomment a line only to change it.

# The only credential this repo takes, and it NEVER ships in the extension: a
# browser extension bundle is readable by anyone who installs it, so the
# Claude read lives behind HTTP instead. Unset means the deterministic verdict
# still works and the agenda read reports itself unavailable.
# ANTHROPIC_API_KEY IS A SECRET. .env is gitignored; never commit a real value.
ANTHROPIC_API_KEY=

# The port the optional server binds.
# BOT_DETECTOR_PORT=3200

# Comma-separated CORS allowlist. An entry matches exactly, or as a bare
# scheme prefix ending in `://` (so `chrome-extension://` covers the extension
# without pinning a per-install id). The default is for local use only; if
# this is ever exposed on a hostname, narrow it to the exact
# `chrome-extension://<id>` and put the hostname behind an identity challenge.
# BOT_DETECTOR_ALLOWED_ORIGINS=chrome-extension://,http://localhost,http://127.0.0.1

# The SQLite cache file, relative to the repo root. A rebuildable cache rather
# than operational state, which is what makes "delete it" safe.
# BOT_DETECTOR_DB_PATH=data/cache.db

# How long a cached profile lives. Profiles hold comment BODIES, so this is a
# data-retention bound and not only a performance knob: expiry is a physical
# DELETE, not a read-time filter.
# BOT_DETECTOR_PROFILE_TTL_SECONDS=21600

# How long a deterministic verdict is reused. A verdict is a pure function of
# the profile, so this only skips the archive round trip.
# BOT_DETECTOR_VERDICT_TTL_SECONDS=86400

# How long a Claude agenda read is reused. Much longer than the verdict TTL on
# purpose: the read costs real money and an account’s agenda moves over weeks,
# not hours.
# BOT_DETECTOR_LLM_TTL_SECONDS=1209600

# The model for the agenda read. Opus rather than a cheap model because this
# is the one judgement call pattern-matching cannot make -- stock talking
# points versus an opinion someone genuinely holds -- and a cheap model gets
# it wrong confidently.
# BOT_AGENDA_MODEL=claude-opus-5

# How many of an account’s comments go into one pack. Caps token cost and,
# just as much, how much of a stranger’s history is shipped to a third party
# in one request.
# BOT_AGENDA_MAX_COMMENTS=60

# Per-comment body budget. Long comments are truncated with a marker rather
# than dropped, so citation ids stay stable.
# BOT_AGENDA_MAX_COMMENT_CHARS=700

# Output budget for the agenda read. THINKING COUNTS AGAINST THIS as well as
# the JSON, which is why it is well above what the report itself needs. A
# max_tokens stop fails loudly rather than handing back truncated JSON.
# BOT_AGENDA_MAX_TOKENS=8000

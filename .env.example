# bot-detector — environment
#
# The data source + scoring core (extension/lib/sources/, extension/lib/scoring/)
# is CREDENTIAL-FREE, on purpose and by necessity:
#
#   * arctic-shift.photon-reddit.com is unauthenticated — no key, no account,
#     no signup. That is exactly why it is the data source (see the header of
#     extension/lib/sources/arcticShift.js for why Reddit's own API is not).
#   * The scoring core is pure functions. No network, no clock, no config.
#   * The Chrome extension must install with load-unpacked and ZERO setup. A
#     required env var in this half would break that outright — there is no
#     .env in a browser.
#
# So this half of the package reads no environment variables at all, and there
# is nothing to copy into a .env to run `npm test` or to load the extension.
#
# The optional Node server half (bot-detector/server/) adds its own vars —
# see the section it appends below this one. Anything user-tunable in the
# *extension* is an extension option (chrome.storage), not an env var.
#
# Per the root CLAUDE.md rule, a var lives in whichever package actually reads
# it. If a future fetcher here needs a credential, add it here with a line
# saying which module reads it — not to skill-backend/.env or task-runner/.env.

# ---------------------------------------------------------------------------
# The optional server (bot-detector/server/) — read by server/config.js
# ---------------------------------------------------------------------------
#
# NONE of this is needed to use the extension. The extension is standalone: it
# calls the archive directly and scores in the browser. Everything below only
# applies if you choose to run the server, which adds exactly two things local
# mode cannot do — the Claude agenda read, and a cache shared across devices.
#
# Start it with `npm install && npm start`, then set the backend URL in the
# extension's options page. With no key set the server still runs and still
# returns deterministic verdicts; it just reports that the agenda read is
# unavailable rather than failing.

# The Messages API call in server/agenda.js. This is a FOURTH independent copy
# of the same key (skill-backend, task-runner and playlist-maker each hold their
# own), per the root CLAUDE.md rule that a var lives in whichever package reads
# it. It never ships in the extension and never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Opus rather than the repo's usual Haiku default, for the same reason
# CHESS_SYNTHESIS_MODEL is: judging whether comments are talking points or a
# genuinely held opinion is the one intelligence-sensitive call here.
BOT_AGENDA_MODEL=claude-opus-5

# How many comments go into the evidence pack. A privacy budget as much as a
# token budget — these are strangers' words.
BOT_AGENDA_MAX_COMMENTS=60
BOT_AGENDA_MAX_COMMENT_CHARS=700

# Output budget. On Opus 5 thinking is on by default and counts against this,
# so a tight value truncates the answer mid-sentence rather than erroring.
BOT_AGENDA_MAX_TOKENS=8000

BOT_DETECTOR_PORT=3200

# SQLite cache — a path, not a credential. Gitignored: it holds strangers'
# comment bodies until their TTL expires.
BOT_DETECTOR_DB_PATH=data/cache.db

# CORS allowlist. Set this to the exact chrome-extension://<id> when exposing
# the server beyond localhost.
BOT_DETECTOR_ALLOWED_ORIGINS=

# Three TTLs because the three things cost wildly different amounts. The
# profile TTL doubles as the retention bound on stored comment bodies.
BOT_DETECTOR_PROFILE_TTL_SECONDS=21600
BOT_DETECTOR_VERDICT_TTL_SECONDS=86400
BOT_DETECTOR_LLM_TTL_SECONDS=1209600
